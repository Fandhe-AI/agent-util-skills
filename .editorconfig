# EditorConfig（https://editorconfig.org）。
#
# エディタ間でインデント・改行・文字コードを統一するための宣言。CI では
# Fandhe-AI/actions の lint-docs reusable workflow（editorconfig-checker）が
# 本ファイルを正として準拠を検証する（イシュー #73 で有効化）。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python は PEP 8 準拠の 4 スペースインデントだが、括弧開きに揃える継続行
# （PEP 8 許容のスタイル）が 4 の倍数にならず checker と両立しないため検査しない
[*.py]
indent_size = unset

# Markdown は行末スペース 2 つが強制改行の意味を持つため除去しない。
# インデント幅もリスト継続行・コードブロック内の任意字下げがあるため検査しない
[*.md]
trim_trailing_whitespace = false
indent_size = unset

# setup-github-pages の rebrand 回帰テスト用 fixture は、docs-site-gen が出力した HTML・JSON を
# バイト一致で保持する（生成器の実出力でなければ上流の DOM 構造ずれを検知できない）。
# 生成器は末尾改行を出力しないため、final newline を要求すると fixture を改変することになる。
# 改行コード（LF）と文字コードの検査は維持する
[skills/setup-github-pages/tests/fixtures/{raw,site-keys}/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
